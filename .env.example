# Copy to .env and fill in. Never commit .env.

# Only needed for discovery runs (replay never calls the LLM).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Login for the local mock bank app. Used by the session provider only,
# never shown to the LLM or written to artifacts/logs.
TARGET_APP_USER=teller
TARGET_APP_PASSWORD=teller-pass
